if SHIELD_RADIANCE_V1 || SHIELD_RADIANCE_V2

config ZMK_KEYBOARD_NAME
    default "Radiance" if SHIELD_RADIANCE_V1
    default "Hannes' Radiance" if SHIELD_RADIANCE_V2

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

# Render the whole 128x32 frame in one buffer so a redraw goes out as a single transfer.
config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif