#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "radiance-scroll.dtsi"

// ISO-DE layout: keycodes are positional (US names), set the OS keyboard layout to German.
// e.g. &kp Y sends "Z", &kp MINUS sends "ß", &kp NUHS sends "#", &kp NUBS sends "<".

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1 &encoder_2>;
        triggers-per-rotation = <20>;
    };

    default_layer {
        compatible = "zmk,keymap";

        0 {
            display-name = "Default";

            sensor-bindings = <&scroll_encoder &inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;

            //  Esc  1  2  3  4  5  6  7  8  9  0  ß  ´  Bksp Bksp Ins
            //  Tab  Q  W  E  R  T  Z  U  I  O  P  Ü  +  Enter Del  Enc1
            //  Caps A  S  D  F  G  H  J  K  L  Ö  Ä  #  Enter Home Enc2
            //  Shft (<>) Y X  C  V  B  N  M  ,  .  -  Shift Up  End
            //  Ctrl Win Alt   Space Space Space   AltGr Menu/Fn Left Down Right
            bindings = <
            &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8  &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC &kp BSPC    &kp INS
            &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I   &kp O     &kp P     &kp LBKT  &kp RBKT  &kp RET  &kp DEL     &kp C_PLAY_PAUSE
            &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K   &kp L     &kp SEMI  &kp SQT   &kp NUHS  &kp RET  &kp HOME    &kp C_MUTE
            &kp LSHFT &kp NUBS  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M   &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP   &kp END
            &kp LCTRL &kp LGUI  &kp LALT            &kp SPACE           &kp SPACE           &kp SPACE         &kp RALT  &lt 1 K_APP &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        fn_layer {
            display-name = "Function";

            sensor-bindings = <&hscroll_encoder &inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;

            // Fn+Esc = ^ (GRAVE), Fn+Y = < (Shift: >, AltGr: |) since the board has no <> key
            bindings = <
            &kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8  &kp F9    &kp F10   &kp F11   &kp F12   &bt BT_CLR &bt BT_CLR &bootloader
            &trans    &none     &none     &none     &none     &none     &none     &none     &none   &none     &kp PSCRN &none     &none     &trans   &out OUT_TOG &trans
            &trans    &none     &none     &none     &none     &none     &none     &none     &none   &none     &none     &none     &none     &trans   &studio_unlock &trans
            &trans    &trans    &kp NUBS  &none     &none     &none     &none     &none     &none   &none     &none     &none     &trans    &kp PG_UP &sys_reset
            &trans    &trans    &trans              &trans              &trans              &trans            &trans    &trans    &bt BT_PRV &kp PG_DN &bt BT_NXT
            >;
        };
    };
};
